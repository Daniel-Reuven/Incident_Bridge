# Copy this file to .env before running the API for real. It is loaded
# automatically by serve_app.py (via python-dotenv) - see README.md, section 15.
# If you run uvicorn directly instead of serve_app.py, nothing loads this
# file for you; either use serve_app.py, or export these variables in
# your shell instead.

# Nothing secret needs to go in this file. On the FIRST start the app shows
# only its setup page (/setup.html; the console prints a setup code): it
# creates the encryption keys and shows the RECOVERY KEY once, creates the
# first admin, optionally stores the AI provider's key, and generates the
# app's own secrets - all kept in the encrypted database.

# OPTIONAL. REGULAR users the setup page creates (role "user" only - an
# admin entry is refused: the first admin is created on the setup page,
# others on the Users page). Read once, at the setup; afterwards manage
# accounts on the Users page (or `python manage_users.py`, server stopped).
# Each must change the password at the first login (see
# REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN). Every password must follow the
# password policy: 8-128 characters with an uppercase letter, a lowercase
# letter, a digit and a symbol, not containing the username, and not a
# common password (see /guide.html#password-policy). The username
# "ai-assistant" (any letter case) is reserved for the built-in AI user.
# INCIDENT_BRIDGE_USERS=[{"username":"tech1","password":"Tech-Start1!","role":"user"},{"username":"tech2","password":"Tech-Start2!","role":"user"},{"username":"tech3","password":"Tech-Start3!","role":"user"}]

# OPTIONAL. Whether a password chosen by someone else must be changed at the
# next login: the users created from INCIDENT_BRIDGE_USERS (those passwords
# are written in a file), accounts an admin creates on the Users page and
# passwords an admin resets there. true (default) | false. Applies when the
# password is set - accounts already waiting for a change keep waiting.
# REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true

# OPTIONAL. Session cookie: a login lasts at most this many hours (default
# 12), and with SESSION_COOKIE_SECURE=true the browser only sends the cookie
# over HTTPS - set it when the app is served over HTTPS (default false, for
# plain http://127.0.0.1 during development). A bad value stops startup.
# SESSION_MAX_AGE_HOURS=12
# SESSION_COOKIE_SECURE=false

# OPTIONAL. Activity log (app/audit.py): every action, HTTP request, external
# call (AI providers, site checks) and a fingerprint of every database record
# saved - ENCRYPTED, one record per line, in a folder per installation:
# <LOG_DIR>/<installation id>/incident_bridge-YYYY-MM.jsonl. Finished months
# are compressed and encrypted into an archive (inside that folder, or under
# LOG_ARCHIVE_DIR/<installation id> when set) and kept until you delete them.
# Relative paths are resolved against backend/. Admins read the log on the
# Logs page; `python manage_logs.py export` writes a readable copy.
# LOG_DIR=logs
# LOG_ARCHIVE_DIR=
# LOG_FILE_ENABLED=true
# How client IP addresses are written, in the log files and on the console:
# hashed (default) = a stable code like ip-3f9a1c0b7d2e that cannot be read
# back (same address -> same code); masked = last part only (***.***.***.1);
# full = as is; off = not at all. Login lockout is unaffected.
# LOG_IP_MODE=hashed

# OPTIONAL. Only needed if the frontend is served from a different origin
# than this API (e.g. during local development with a separate dev
# server). Comma-separated list of allowed origins. Leave unset for a
# same-origin setup (frontend served by this same app, or both behind one
# reverse proxy) - no CORS needed at all in that case.
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# OPTIONAL - only read by serve_app.py, not by the app itself. Controls
# what serve_app.py passes to uvicorn.run(). The defaults below are used
# when these are unset.
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true

# OPTIONAL. The database file holding incidents (with their comments), user
# accounts, sites, the AI queue and the app's settings - ENCRYPTED (SQLCipher,
# see app/database.py). Defaults to backend/incident_bridge.db (created at the
# setup). Its keys file is <DATABASE_PATH>.keys (DATABASE_KEYS_PATH to move
# it) - no secret on its own, but the database cannot be opened without it
# except with the recovery key (python manage_keys.py restore).
# DATABASE_PATH=incident_bridge.db
# DATABASE_KEYS_PATH=incident_bridge.db.keys
# Where the machine key goes at the setup (and at `manage_keys.py restore`):
#   auto (default) = a systemd credential if present, else the computer's
#   credential store (Windows Credential Manager / macOS Keychain / Linux
#   desktop Secret Service), else a key file readable only by this user
#   keyring | systemd | file = force one. MACHINE_KEY_DIR = the key file's
#   folder (default: your user's app-data folder, never the project).
# KEY_PROVIDER=auto
# MACHINE_KEY_DIR=

# OPTIONAL. Seed files for the Sites & Mailing Lists subsystem (see
# app/sites.py). A file is imported at startup ONLY when its variable is set
# to a path; if the line is commented out or empty, nothing is imported and
# nothing is printed. Relative paths are resolved against the repository
# root. Ids already stored in the database are always skipped, so leaving
# these on never overwrites edits made in the app.
# SITES_SEED_PATH=data/sites.jsonl
# MAILING_LISTS_SEED_PATH=data/mailing_lists.jsonl

# OPTIONAL. Site availability checks (see app/services/availability.py).
# Give up on a site after this many seconds (default 5), and count a
# response slower than this many milliseconds as Degraded (default 2000).
# A value that is not a positive number stops startup with a clear error.
# SITE_CHECK_TIMEOUT_SECONDS=5
# SITE_CHECK_SLOW_MS=2000

# OPTIONAL. Site portal notification archive (see app/sites.py).
# A sent, dismissed or skipped notification moves from the Notifications tab
# to the Archive tab (view only) this many days after it was finished
# (default 30; fractions work, e.g. 0.5 = 12 hours; 0 = never archive).
# Notifications waiting for a decision are never archived.
# A value that is not a number of 0 or more stops startup with a clear error.
# NOTIFICATION_ARCHIVE_DAYS=30

# OPTIONAL. AI analysis of faults - the "Analyze using <provider>" button on
# a fault page (see app/ai/). The easiest way is the setup page, which keeps
# the key encrypted in the database; settings chosen there take precedence
# over the ones below, which still work (e.g. for `main.py --live`).
# One provider at a time:
#   gemini (default) | claude | openai | fake (canned answers, no key - for trying it out)
# The feature is OFF while the selected provider's API key is not set.
# No extra package is needed: every provider's REST API is called with
# `requests` (app/api_client.py). Keys are sent in request headers only and
# never written to the log.
# Models: a model setting holds one model or a comma-separated list, best
# first. When a model is busy or out of quota (HTTP 429/503/500/504, or 404
# for a retired model), the next one in the list is tried; the analysis
# fails only when the last one does. Model lists:
#   Gemini: https://ai.google.dev/gemini-api/docs/models
#   Claude: https://docs.claude.com/en/docs/about-claude/models/overview
#   OpenAI: https://platform.openai.com/docs/models
# Queued analyses survive a restart and go to whichever provider is
# configured at that time.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# Gemini needs no model setting - GEMINI_TIER picks the list (see
# app/ai/providers/gemini_models.py):
#   free (default): gemini-3.8-flash > gemini-3.6-flash > gemini-3.5-flash-lite > gemini-3.1-flash-lite
#   paid:           gemini-3.1-pro-preview, then the free list (uses paid credits)
# Google has no API that tells a free key from a paid one, so say which yours is.
# GEMINI_TIER=free
# Or your own list instead of the tier's (e.g. to avoid paid credits on a paid key):
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Model discovery (opt-in): when the AI worker starts (on the first analysis
# request - the provider is only created then), ask Google which models the key can
# use, drop retired ones, and put NEWER stable models first - flash and
# flash-lite on the free tier, plus pro only with GEMINI_TIER=paid (no
# Google API can confirm a key has credits, so the tier setting is the
# confirmation). Previews are never added. A GEMINI_MODELS list is only
# checked, never extended. off (default) | auto
# GEMINI_MODEL_DISCOVERY=off
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Shared by every provider: give up on one AI call after this many seconds
# (default 180 - per model attempt; a timeout does NOT fall back to the next
# model), and wait this many seconds after each analysis before the next one
# (default 5). A value that is not a valid number stops startup.
# AI_REQUEST_TIMEOUT_SECONDS=180
# AI_REQUEST_DELAY_SECONDS=5
# Re-analysis rule (app/ai/reanalysis.py): after a successful analysis, the
# same fault can't be analyzed again with the same provider until someone
# changes it (a comment, status, severity, assignee...). An admin can force
# it ("Re-analyze") only after this many seconds since that analysis.
# AI_REANALYSIS_COOLDOWN_SECONDS=300
# Console log of the AI queue (app/ai/log.py): every request, refusal,
# cancel, job start/finish and model attempt, each ending with the queue's
# state. INFO (default) | WARNING (problems only) | DEBUG (adds pauses) | OFF
# AI_LOG_LEVEL=INFO
