# Copy this file to .env before running the API for real. It is loaded
# automatically by serve_app.py (via python-dotenv) - see backend/README.md.
# If you run uvicorn directly instead of serve_app.py, nothing loads this
# file for you; either use serve_app.py, or export these variables in
# your shell / your hosting platform's dashboard (e.g. Render's
# Environment tab) instead.

# REQUIRED for anything beyond local testing. If unset, the app falls back
# to a demo admin/user pair with well-known passwords and prints a loud
# warning - fine for poking at it locally, never for anything reachable
# by anyone else.
INCIDENT_BRIDGE_USERS=[{"username":"admin","password":"123456789","role":"admin"},{"username":"tech1","password":"123456789","role":"user"},{"username":"tech2","password":"123456789","role":"user"},{"username":"tech3","password":"123456789","role":"user"}]

# REQUIRED before deploying anywhere reachable by anyone else. Signs the
# session cookie - if unset, an insecure hardcoded default is used (with
# a warning printed at startup). Use a long random string.
# Example command to generate string: ```-join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Max 256) })```
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# OPTIONAL. Only needed if the frontend is served from a different origin
# than this API (e.g. during local development with a separate dev
# server). Comma-separated list of allowed origins. Leave unset for a
# same-origin deployment (frontend served by this same app, or
# reverse-proxied together on Render) - no CORS needed at all in that case.
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# OPTIONAL - only read by serve_app.py, not by the app itself. Controls
# what serve_app.py passes to uvicorn.run(). Render sets PORT itself, so
# leave this unset when deploying there rather than hardcoding a value.
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true

# OPTIONAL. Where incidents (and their comments) are persisted - see
# app/persistence.py. Defaults to backend/incident_bridge.db (created
# automatically) if unset. Users are NOT stored here - they always come
# from INCIDENT_BRIDGE_USERS above, every time the process starts.
# DATABASE_PATH=incident_bridge.db

# OPTIONAL. Seed files for the Sites & Mailing Lists subsystem (see
# app/sites.py). A file is imported at startup ONLY when its variable is set
# to a path; if the line is commented out or empty, nothing is imported and
# nothing is printed. Relative paths are resolved against the repository
# root. Ids already stored in the database are always skipped, so leaving
# these on never overwrites edits made in the app.
# SITES_SEED_PATH=data/sites.jsonl
# MAILING_LISTS_SEED_PATH=data/mailing_lists.jsonl

# OPTIONAL. Site availability checks (see app/services/availability.py).
# Give up on a site after this many seconds (default 5), and count a
# response slower than this many milliseconds as Degraded (default 2000).
# A value that is not a positive number stops startup with a clear error.
# SITE_CHECK_TIMEOUT_SECONDS=5
# SITE_CHECK_SLOW_MS=2000